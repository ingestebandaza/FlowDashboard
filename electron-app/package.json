{
    "name":  "flowdashboard",
    "version":  "2.1.0",
    "description":  "FlowDashboard - Android device operations dashboard",
    "main":  "src/main/index.js",
    "scripts":  {
                    "start":  "electron .",
                    "dev":  "electron . --dev",
                    "build":  "electron-builder --config electron-builder.config.js",
                    "build:win":  "electron-builder --win --x64 --config electron-builder.config.js",
                    "build:dir":  "electron-builder --win --x64 --dir --config electron-builder.config.js",
                    "build:installer":  "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\build\\build-electron-installer.ps1"
                },
    "keywords":  [
                     "android",
                     "adb",
                     "automation",
                     "streaming"
                 ],
    "author":  "FlowDashboard",
    "license":  "MIT",
    "devDependencies":  {
                            "electron":  "^28.0.0",
                            "electron-builder":  "^24.9.1"
                        },
    "dependencies":  {
                         "@microsoft/signalr":  "^8.0.17",
                         "axios":  "^1.6.2",
                         "electron-updater":  "^6.8.9"
                     },
    "build":  {
                  "appId":  "com.flowdashboard.app",
                  "productName":  "FlowDashboard",
                  "directories":  {
                                      "output":  "../release_packages",
                                      "buildResources":  "assets"
                                  },
                  "files":  [
                                "src/**/*",
                                "preload/**/*",
                                "assets/**/*",
                                "package.json",
                                "node_modules/**/*",
                                "!dist/**/*",
                                "!electron-console.log",
                                "!*.log"
                            ],
                  "extraResources":  [
                                         {
                                             "from":  "../build/staging/commercial-resources",
                                             "to":  ".",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         },
                                         {
                                             "from":  "assets",
                                             "to":  "assets",
                                             "filter":  [
                                                            "**/*"
                                                        ]
                                         }
                                     ],
                  "asar":  true,
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "assets/icon.ico",
                              "publisherName":  "FlowDashboard",
                              "signAndEditExecutable":  false,
                              "signDlls":  false,
                              "forceCodeSigning":  false
                          },
                  "nsis":  {
                               "oneClick":  true,
                               "perMachine":  false,
                               "allowElevation":  false,
                               "allowToChangeInstallationDirectory":  false,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "FlowDashboard",
                               "deleteAppDataOnUninstall":  false,
                               "include":  "build/installer.nsh"
                           },
                  "artifactName":  "FlowDashboard-Setup-${version}.${ext}",
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "owner":  "ingestebandaza",
                                      "repo":  "FlowDashboard",
                                      "releaseType":  "release"
                                  }
                              ]
              }
}
